# Переменные окружения. Значения не коммитятся: копия этого файла — .env на сервере, права 600.
# Полный список контура — раздел 5.1 ТЗ; здесь то, что читает код.

# --- база
DATABASE_URL=postgresql://ruware:<пароль>@db:5432/ruware_hr
# ключ шифрования токенов внешних сервисов: python -m hr.cli gen-key
SECRETS_KEY=

# --- языковая модель (раздел 6 ТЗ); пусто — объяснения по шаблону
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90

# --- эмбеддинги для поиска по смыслу; пусто — вектор считается в коде (hash-v1)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# --- hh.ru (раздел 5.2 ТЗ)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REFRESH_TOKEN=
HH_EMPLOYER_ID=
HH_USER_AGENT="RuwareHR/1.0 (hr@example.ru)"
HH_REDIRECT_URI=https://hr.example.ru/api/oauth/hh/callback

# --- «Работа России»: отложена до после MVP (docs/work/core, T15)
TRUDVSEM_BASE=https://opendata.trudvsem.ru/api/v1

# --- следы в сети
GITHUB_TOKEN=

# --- выгрузки из кабинетов площадок
IMPORT_DIR=./data/import
